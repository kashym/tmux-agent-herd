{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "__HERD_HOOK__ --agent codex working", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "__HERD_HOOK__ --agent codex working", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "__HERD_HOOK__ --agent codex working", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "__HERD_HOOK__ --agent codex blocked", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "__HERD_HOOK__ --agent codex done", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "__HERD_HOOK__ --agent codex none", "timeout": 2 }] }
    ]
  }
}
